# Base de datos PostgreSQL (la misma en desarrollo, test y producción)
DATABASE_URL="postgresql://postgres@localhost:5432/cdb_dev"

# Secreto para firmar las sesiones (mínimo 32 caracteres aleatorios)
AUTH_SECRET="cambia-este-secreto-por-uno-largo-y-aleatorio-de-32-caracteres"

# URL pública del sitio
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Stripe (si se dejan vacías, la pasarela funciona en MODO DEMO sin cobros reales)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Credenciales del administrador inicial (usadas por `npm run db:seed`)
ADMIN_EMAIL="admin@clubdeportivobomberos.es"
ADMIN_PASSWORD="Admin1234!"

# Correo saliente (recuperación de contraseña y avisos de renovación).
# Sin ninguna de las dos, los correos se registran en /admin/correos pero no salen.
# Opción A · Resend: https://resend.com
RESEND_API_KEY=""
# Opción B · SMTP del propio dominio del club
SMTP_URL=""
MAIL_FROM="Club Deportivo Bomberos de Madrid <no-responder@clubdeportivobomberos.es>"
UPLOADS_DIR=""

# Modo demostración: aviso visible y página /demo con las cuentas de prueba
DEMO_MODE=""
# Dónde se guardan las imágenes subidas: "disco" (VPS) o "base-datos" (sin disco)
MEDIA_STORAGE="disco"
